# =============================================================================
# .env.example — Your Own API Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in your values before running the app.
# NEVER commit the actual .env file to version control.
# =============================================================================

# ─────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────

# Environment: "development" | "production" | "testing"
ENVIRONMENT=development

# Application version (used in logs and API responses)
APP_VERSION=1.0.0

# ─────────────────────────────────────────────────
# DATABASE — PostgreSQL
# ─────────────────────────────────────────────────

# For LOCAL development (SQLite — no Docker needed):
DATABASE_URL=sqlite:///./api.db

# For DOCKER / PRODUCTION (PostgreSQL — matches docker-compose.yml):
# DATABASE_URL=postgresql://yourownapi:changeme_in_production@db:5432/yourownapi_db

# PostgreSQL credentials (used by docker-compose to create the database)
POSTGRES_USER=yourownapi
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=yourownapi_db

# ─────────────────────────────────────────────────
# REDIS — Caching & Rate Limit Store
# ─────────────────────────────────────────────────

# For LOCAL development (no Redis): leave blank or use a local Redis instance
# REDIS_URL=redis://localhost:6379/0

# For DOCKER / PRODUCTION:
# REDIS_URL=redis://:changeme_redis@redis:6379/0

REDIS_URL=
REDIS_PASSWORD=changeme_redis

# ─────────────────────────────────────────────────
# JWT AUTHENTICATION
# ─────────────────────────────────────────────────

# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ─────────────────────────────────────────────────
# RATE LIMITING DEFAULTS
# ─────────────────────────────────────────────────

# Default daily request limit for newly registered API keys (Free Tier)
DEFAULT_RATE_LIMIT_DAILY=100

# ─────────────────────────────────────────────────
# AI PROVIDERS
# ─────────────────────────────────────────────────

# Default provider: "mock" | "ollama" | "gemini" | "claude"
AI_PROVIDER=mock

# Ollama (local LLaMA / Mistral) — runs on your machine or a local container
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Google Gemini API — https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic Claude API — https://console.anthropic.com/
CLAUDE_API_KEY=

# ─────────────────────────────────────────────────
# STRIPE BILLING (Phase 4 — not active yet)
# ─────────────────────────────────────────────────

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FREE_PRICE_ID=
STRIPE_PRO_PRICE_ID=price_REPLACE_WITH_REAL_ID
STRIPE_ENTERPRISE_PRICE_ID=price_REPLACE_WITH_REAL_ID

# ─────────────────────────────────────────────────
# EMAIL / SMTP (Phase 4 — invoices)
# ─────────────────────────────────────────────────

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ─────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Directory for log files (relative to project root)
LOG_DIR=./logs

# ─────────────────────────────────────────────────
# CORS — Frontend Origins
# ─────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins
# For development: http://localhost:5173
# For production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
