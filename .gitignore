# =============================================================================
# .gitignore — Your Own API
# =============================================================================

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env.bak

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Environment & secrets — NEVER commit these ────────────────────────────────
.env
!.env.example

# ── Local SQLite database ─────────────────────────────────────────────────────
*.db
*.sqlite3

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Nginx SSL certs (auto-generated, not committed) ───────────────────────────
nginx/ssl/*.pem
nginx/ssl/*.crt
nginx/ssl/*.key
!nginx/ssl/README.md

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# ── SDK build artefacts ───────────────────────────────────────────────────────
sdk/python/dist/
sdk/python/*.egg-info/
sdk/js/dist/
sdk/js/node_modules/
